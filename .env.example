# ─────────────────────────────────────────────────────────────────────────────
# AutoDeploy Platform — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_postgres_password

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=  # leave blank for local dev, set in prod

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_STRONG_BASE64_SECRET_AT_LEAST_64_CHARS_LONG==
JWT_EXPIRATION_MS=86400000        # 24 hours
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 days

# ── Encryption (AES-256 for GitHub tokens & env vars) ────────────────────────
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_AES_KEY=

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_WEBHOOK_SECRET=your_random_webhook_hmac_secret

# ── AWS (real or LocalStack) ─────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test           # LocalStack uses "test"
AWS_SECRET_ACCESS_KEY=test       # LocalStack uses "test"
# For LocalStack override
AWS_ENDPOINT_URL=http://localstack:4566

# ECR
ECR_REGISTRY_URL=123456789.dkr.ecr.us-east-1.amazonaws.com   # Replace with real account
ECR_REPOSITORY_NAME=autodeploy

# Route53
ROUTE53_HOSTED_ZONE_ID=REPLACE_WITH_HOSTED_ZONE_ID
PLATFORM_DOMAIN=autodeploy.example.com    # e.g., yourdomain.com
TRAEFIK_LB_IP=1.2.3.4                    # Public IP of your Traefik load balancer

# ── Discovery Service (Eureka) ────────────────────────────────────────────────
EUREKA_URL=http://discovery-service:8761/eureka/

# ── Email (Notification Service — optional) ──────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@autodeploy.example.com

# ── Build Service ─────────────────────────────────────────────────────────────
# Directory on the build host where repos are cloned
BUILD_WORKSPACE_DIR=/tmp/autodeploy-builds
# Kaniko executor image
KANIKO_EXECUTOR_IMAGE=gcr.io/kaniko-project/executor:latest

# ── Deployment Service ────────────────────────────────────────────────────────
# Base64-encoded private key for SSH into EC2 instances
EC2_SSH_PRIVATE_KEY_BASE64=REPLACE_WITH_BASE64_ENCODED_PEM_KEY
EC2_SSH_USER=ec2-user

# ── Internal service auth (shared secret for gateway → service calls) ─────────
INTERNAL_API_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET
