# ── Maven ──────────────────────────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── IDE ────────────────────────────────────────────────────────────────────
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Docker ─────────────────────────────────────────────────────────────────
# Don't ignore docker-compose.yml — it's a dev file we want tracked
# But ignore local override
docker-compose.override.yml

# ── Secrets & Environment ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.jks
*.p12

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/
spring.log

# ── Build artifacts ────────────────────────────────────────────────────────
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# ── Terraform ──────────────────────────────────────────────────────────────
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
terraform/tfplan
terraform/policies/

# ── Kubernetes ─────────────────────────────────────────────────────────────
# Never commit real secrets — use kubectl create secret or a secrets manager
k8s/secrets-*.yml
!k8s/secrets.yml

# ── Frontend production env ────────────────────────────────────────────────
frontend/.env.local
frontend/.env.*.local

# ── Node modules ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
